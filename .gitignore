__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.idea/
.vscode/

# A recorded match holds the Steam IDs of BOTH players. None of it belongs in
# a public repo: publishing it would expose the match history of people who
# never agreed to anything.
data/recorded/
# Observed Steam IDs and names. Not ours to publish.
data/identity.json
# Who agreed to be tracked — a list of real Steam IDs, so the same applies.
data/consent.json
# Any database, not just the default name: the sidecar -wal/-shm files are
# just as revealing and easy to miss.
data/*.sqlite*
data/ratings.json
# What the *client* writes next to itself while running: the server it is
# pointed at and the bearer token for the logged-in session. The token is a
# credential — a live login for whoever holds it — and both were committed by
# accident.
data/session.txt
data/server.txt
data/seed/
matches/

# Backups lobby_config.py writes
*.backup_*

# Game data stays out of the repository (someone else's copyright). Pools and
# constants are read from the local installation at runtime.
*.fwe
*.fwr
*.fwc
constants*.lua
log.txt
log*.dat

# Secrets never belong in the repository
.env
.env.*

# .NET build artefacts, regenerated on every build
ui/bin/
ui/obj/
*.user

# Deployment for one specific host. The server exists only as a sync backend
# for the client, so how it is hosted is nobody else's business and belongs
# nowhere near a public repository.
deploy/
