# systemd unit for the ladder API.
#
# Binds to loopback only — nginx terminates TLS and proxies in. Exposing
# uvicorn directly would mean a public HTTP port with no certificate.
#
#   install: /etc/systemd/system/forts-ladder.service

[Unit]
Description=Forts Ladder API
Documentation=https://github.com/Luca-dev-archiv/forts-ladder
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=fortsladder
Group=fortsladder
WorkingDirectory=/opt/forts-ladder

Environment=LADDER_DB=/var/lib/forts-ladder/ladder.sqlite
# Overridden by the EnvironmentFile below, which is where the
# real hostname belongs — not in a file in the repository.
Environment=LADDER_BASE_URL=https://ladder.example.com
Environment=PYTHONUNBUFFERED=1
# Secrets belong in this file, not in the unit: it is root-owned 0600 and is
# not in the repository. Missing is fine — the OAuth endpoints refuse loudly
# rather than pretending to work.
EnvironmentFile=-/etc/forts-ladder/env

# One worker on purpose. The live-match list is in-process state, so a second
# worker would serve a different view of who is playing depending on which one
# answered. A few hundred players do not need more than one.
ExecStart=/opt/forts-ladder/.venv/bin/uvicorn server.app:app \
    --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=3

# Hardening. The service needs to read its own directory and write one
# database, and nothing else on the machine — which matters here because this
# box runs other things.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/forts-ladder

[Install]
WantedBy=multi-user.target
