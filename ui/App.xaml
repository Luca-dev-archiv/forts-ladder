<Application x:Class="FortsLadder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Dark surface, one warm accent. Deliberately its own colours and
           its own name: imitating someone else's brand would be the wrong
           signal in a scene that runs on trust. -->
      <Color x:Key="BgDeepColor">#0F1115</Color>
      <Color x:Key="AccentColor">#FF6B2C</Color>

      <SolidColorBrush x:Key="BgDeep"    Color="#0F1115"/>
      <SolidColorBrush x:Key="BgPanel"   Color="#171A21"/>
      <SolidColorBrush x:Key="BgCard"    Color="#1E222B"/>
      <SolidColorBrush x:Key="BgHover"   Color="#262B36"/>
      <SolidColorBrush x:Key="Stroke"    Color="#2A2F3A"/>
      <SolidColorBrush x:Key="Accent"    Color="#FF6B2C"/>
      <SolidColorBrush x:Key="AccentDim" Color="#7A3517"/>
      <SolidColorBrush x:Key="TextHi"    Color="#F2F4F8"/>
      <SolidColorBrush x:Key="TextMid"   Color="#A7B0C0"/>
      <SolidColorBrush x:Key="TextLow"   Color="#6B7488"/>
      <SolidColorBrush x:Key="Win"       Color="#3DD68C"/>
      <SolidColorBrush x:Key="Loss"      Color="#F0616D"/>
      <SolidColorBrush x:Key="Warn"      Color="#FFB020"/>

      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      </Style>

      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>

      <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Background" Value="{StaticResource BgHover}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}"
                      CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                  <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="#160B04"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- The WPF default is a white box, which on a dark surface reads as
           a rendering bug. -->
      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Background" Value="{StaticResource BgHover}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Padding" Value="8,5"/>
      </Style>

      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
