<Window x:Class="FortsLadder.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FortsLadder.Core"
        Title="Forts Ladder" SizeToContent="Height" Width="480"
        MinHeight="150" MaxHeight="620"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        ShowInTaskbar="False" ResizeMode="NoResize">

  <!-- Same chrome treatment as the main window. Every message the program
       showed came out of MessageBox, which draws the operating system's own
       grey dialog: correct, and jarring next to everything else. Keeping
       WindowChrome means dragging and the Escape/Enter keys still behave. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="0"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#12141A"
              BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <!-- The accent stripe carries the kind of message: orange for a
               question, red for something that failed. A dialog with no colour
               at all made "your session expired" and "this deletes things" look
               identical. -->
          <Border x:Name="KindStripe" DockPanel.Dock="Left" Width="3"
                  Margin="0,6,10,6" CornerRadius="2"
                  Background="{StaticResource Accent}"/>
          <TextBlock x:Name="TitleText" DockPanel.Dock="Left"
                     VerticalAlignment="Center" FontSize="12"
                     FontWeight="SemiBold" Foreground="{StaticResource TextHi}"
                     TextTrimming="CharacterEllipsis"/>
          <Button x:Name="BtnDismiss" DockPanel.Dock="Right" Width="34"
                  Height="34" Content="&#xE711;"
                  FontFamily="Segoe MDL2 Assets" FontSize="10"
                  Style="{StaticResource TitleBtn}"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="BtnCancel_Click"/>
        </DockPanel>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Padding="18,16,18,4">
        <StackPanel>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                     LineHeight="19"
                     Foreground="{StaticResource TextHi}"/>
          <!-- The error code on its own line, selectable, because the whole
               point of a code is that it gets copied into Discord. -->
          <TextBox x:Name="CodeBox" Visibility="Collapsed" Margin="0,10,0,0"
                   IsReadOnly="True" BorderThickness="0" FontSize="11"
                   Background="Transparent"
                   Foreground="{StaticResource TextMid}"/>
          <TextBox x:Name="InputBox" Visibility="Collapsed" Margin="0,12,0,0"
                   MinHeight="26" TextWrapping="Wrap" AcceptsReturn="False"/>
          <TextBlock x:Name="HintText" Visibility="Collapsed" Margin="0,8,0,0"
                     Style="{StaticResource Label}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Buttons -->
      <Border Grid.Row="2" Padding="18,12,18,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnCancel" Style="{StaticResource Btn}"
                  Padding="16,6" Margin="0,0,8,0" Visibility="Collapsed"
                  Content="{core:T dialog.cancel}" Click="BtnCancel_Click"
                  IsCancel="True"/>
          <Button x:Name="BtnOk" Style="{StaticResource BtnAccent}"
                  Padding="20,6" Content="{core:T dialog.ok}"
                  Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
