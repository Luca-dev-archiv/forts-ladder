<Window x:Class="FortsLadder.IdentityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FortsLadder.Core"
        Title="{core:T identity.title}" Height="430" Width="500"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <StackPanel Margin="26,22,26,20">

    <TextBlock Text="{core:T identity.headline}" FontSize="18" FontWeight="Bold"/>
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMid}"
               FontSize="12" Margin="0,6,0,0"
               Text="{core:T identity.explain}"/>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,11">
      <StackPanel>
        <TextBlock Text="{core:T identity.detected}" Style="{StaticResource Label}"/>
        <TextBlock x:Name="PersonaText" FontSize="14" Margin="0,3,0,0"/>
        <TextBlock x:Name="SteamIdText" Style="{StaticResource Label}"/>
      </StackPanel>
    </Border>

    <TextBlock Text="{core:T identity.your_name}" Style="{StaticResource Label}" Margin="0,18,0,6"/>
    <Border Background="{StaticResource BgPanel}" CornerRadius="6"
            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
            Padding="10,7">
      <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0"
               Foreground="{StaticResource TextHi}" FontSize="14"
               CaretBrush="{StaticResource Accent}"
               TextChanged="NameBox_TextChanged"/>
    </Border>

    <TextBlock x:Name="HintText" Style="{StaticResource Label}" Margin="0,6,0,0"
               TextWrapping="Wrap"/>

    <ListBox x:Name="Suggestions" Background="Transparent" BorderThickness="0"
             MaxHeight="96" Margin="0,4,0,0" Visibility="Collapsed"
             SelectionChanged="Suggestions_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" Foreground="{StaticResource TextHi}"
                     FontSize="13" Padding="4,3"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
      <Button x:Name="BtnOk" Content="{core:T identity.save}" Style="{StaticResource BtnAccent}"
              Click="BtnOk_Click" IsDefault="True"/>
      <Button Content="{core:T identity.not_listed}" Style="{StaticResource Btn}"
              Margin="8,0,0,0" Click="BtnSkip_Click"/>
      <Button Content="{core:T identity.later}" Style="{StaticResource Btn}" Margin="8,0,0,0"
              IsCancel="True" Click="BtnLater_Click"/>
    </StackPanel>

  </StackPanel>
</Window>
