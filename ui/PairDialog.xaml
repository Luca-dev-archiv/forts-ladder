<Window x:Class="FortsLadder.PairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FortsLadder.Core"
        Title="{core:T login.pair_title}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeep}">
  <StackPanel Margin="26,22,26,20">
    <TextBlock Text="{core:T login.pair_headline}" FontSize="17"
               FontWeight="Bold"/>
    <TextBlock x:Name="Reason" Style="{StaticResource Label}"
               TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{StaticResource Warn}"/>
    <TextBlock Text="{core:T login.pair_explain}" TextWrapping="Wrap"
               Foreground="{StaticResource TextMid}" FontSize="12"
               Margin="0,10,0,0"/>

    <Button x:Name="BtnOpen" Content="{core:T login.pair_open}"
            Style="{StaticResource Btn}" Margin="0,14,0,0"
            HorizontalAlignment="Left" Click="BtnOpen_Click"/>

    <TextBlock Text="{core:T login.pair_code}" Style="{StaticResource Label}"
               Margin="0,16,0,4"/>
    <TextBox x:Name="CodeBox" Height="38" FontFamily="Consolas" FontSize="17"
             VerticalContentAlignment="Center" Padding="10,0"
             CharacterCasing="Upper"/>

    <TextBlock x:Name="Error" Foreground="{StaticResource Loss}" FontSize="12"
               TextWrapping="Wrap" Margin="0,8,0,0"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="BtnCancel" Content="{core:T common.cancel}"
              Style="{StaticResource Btn}" Padding="16,7"
              Click="BtnCancel_Click"/>
      <Button x:Name="BtnOk" Content="{core:T login.pair_connect}"
              Style="{StaticResource BtnAccent}" Padding="20,7"
              Margin="8,0,0,0" Click="BtnOk_Click" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
